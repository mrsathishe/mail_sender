# App
APP_URL=http://localhost:3000

# JWT session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32

# MongoDB (password must be URL-encoded in the URI: @ -> %40)
MONGO_URI=mongodb://user:pass@host:27017/mail_sender?authSource=mail_sender

# Sending account (ours) — every submission is delivered FROM this address.
#
# SMTP_HOST is REQUIRED: there is no default, so a missing value fails loudly
# instead of quietly sending through someone else's server.
#
# Current setup — GoDaddy Professional Email (satz.co.in MX = *.secureserver.net):
#   Outgoing (submission) host is smtpout.secureserver.net — NOT the MX host
#   smtp.secureserver.net, which only receives. Username is the FULL address.
#   465 (SSL) and 587 (STARTTLS) both work; 3535 is a documented fallback.
#   A fresh mailbox can return "535 Authentication Failed" for a few minutes after
#   the password is set — retry before assuming the port or password is wrong.
#   Do NOT use mail.satz.co.in — that name points at the VPS running this app.
# Other providers, for reference:
#   Zoho              : smtp.zoho.in      465
#   Gmail / Workspace : smtp.gmail.com    587   (App Password, not the account password)
#   Resend            : smtp.resend.com   587   (SMTP_USER=resend, SMTP_PASS=API key)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
# Optional; inferred from the port (true for 465, false otherwise).
# SMTP_SECURE=false
SMTP_USER=mail@satz.co.in
SMTP_PASS=the-mailbox-password
# Optional; defaults to SMTP_USER. A display name needs no quotes here — avoid
# them, since systemd's EnvironmentFile parses quoted segments differently.
SMTP_FROM=Mailer by satz <mail@satz.co.in>

# --- Sending limits ---------------------------------------------------------
# Emails a single app may send per UTC day (SPEC §4c). Optional; defaults to 500,
# which is the figure the public docs quote — they read this value, so changing it
# changes the documentation too. An unparseable value throws at request time rather
# than silently becoming "unlimited".
SEND_APP_DAILY_LIMIT=500

# --- Spam filtering ---------------------------------------------------------
# Score at or above which a submission is refused with 422 spam_rejected
# (SPEC §4d, src/lib/spam-score.ts). Optional; defaults to 6. A knob because the
# right number is only learnable from real traffic: lower it to tighten, raise it to
# loosen, and set it very high to effectively switch the filter off. An unparseable
# value throws rather than silently blocking everything.
SPAM_SCORE_THRESHOLD=6
